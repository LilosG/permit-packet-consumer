      },
      {
        "item": "Local Building Inspector approval required prior to NV Energy connecting service or setting meter",
        "quote": "Customer installations must be approved by the local 'Building Inspector' in all areas, prior to the connection of service or setting of meter.",
        "url": "https://www.nvenergy.com/publish/content/dam/nvenergy/brochures_arch/account-services/building-and-new-construction/electric-service-standards-north/section-7/OS0001U.pdf",
        "ok": true
      },
      {
        "item": "Submit solar PV and energy storage interconnection applications online via NV Energy PowerClerk with application fee",
        "quote": "Applications are submitted through the online application portal, PowerClerk. Applications will be considered incomplete until the application fee has been paid.",
        "url": "https://www.nvenergy.com/publish/content/dam/nvenergy/brochures_arch/cleanenergy/handbooks/SolarGenerations-Handbook.pdf",
        "ok": true
      },
      {
        "item": "Solar/ESS interconnections must be permitted locally and performed by a Nevada licensed C-2 or C-2g electrical contractor",
        "quote": "Installations must be permitted through the local building authority and interconnections must be performed by a Nevada licensed C-2 or C-2g electrical contractor.",
        "url": "https://www.nvenergy.com/publish/content/dam/nvenergy/brochures_arch/cleanenergy/handbooks/SolarGenerations-Handbook.pdf",
        "ok": true
      }
    ]
